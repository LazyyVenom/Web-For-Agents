{
  "name": "@anubhav-choubey/web-for-agents",
  "version": "0.3.0",
  "description": "SEO and AI-agent readiness for React + Vite: head tags, JSON-LD, prerendering, markdown pages, llms.txt, agents.json and WebMCP",
  "license": "MIT",
  "author": "Anubhav Choubey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LazyyVenom/Web-For-Agents.git"
  },
  "bugs": {
    "url": "https://github.com/LazyyVenom/Web-For-Agents/issues"
  },
  "homepage": "https://github.com/LazyyVenom/Web-For-Agents#readme",
  "keywords": [
    "seo",
    "llm",
    "llms.txt",
    "ai",
    "agents",
    "react",
    "vite",
    "json-ld",
    "sitemap",
    "robots.txt",
    "prerender",
    "markdown",
    "webmcp",
    "agents.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "web-for-agents": "dist/bin.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vite": [
        "dist/vite.d.ts"
      ],
      "cli": [
        "dist/cli.d.ts"
      ],
      "overlay": [
        "dist/overlay.d.ts"
      ],
      "schema": [
        "dist/schema.d.ts"
      ],
      "link": [
        "dist/link.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "demo:dev": "vite examples/demo",
    "demo:build": "vite build examples/demo --outDir dist-demo --emptyOutDir",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "test": "vitest run",
    "test:pack": "npm run build && vitest run --config vitest.pack.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "happy-dom": "^21.0.4",
    "turndown": "^7",
    "turndown-plugin-gfm": "^1"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
